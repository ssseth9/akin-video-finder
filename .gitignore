# Eval staging dir holds copied media for un-linkable volumes
.eval_stage/

# Generated code-review diff dumps
review_packet.txt
review_bundle.diff

# One-off measurement scripts and their logs. They name real files and
# paths from the collection, so they stay local like the label exports.
tmp_*

# Built installers are release assets, not repository content
# (docs/release-process.md). A 66 MB installer once lived here.
installer/*.exe

# Agent tooling state. context/ is the tracked "why" layer; these are not.
.claude/
/CLAUDE.md

# IDE (Windows)
.vs/

# Windows device artifact
nul
.cortex/

# Local data. The databases, label exports, backups and report exports all
# name real collection paths, and no code reads this directory.
/data/

# Agent session plans. Durable config under .kilo/ (commands, agents,
# kilo.json) stays committable, unlike .claude/.
/.kilo/plans/

# GUI test screenshots capture the local Windows profile path in folder rows.
/docs/261119_testing/screenshots/
/docs/*_testing/screenshots/

# Parking lot for the 2026-11-19 root reorganisation; emptied once the move
# is committed.
/_trash_2026-11-19/
